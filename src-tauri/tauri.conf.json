{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "420vision",
  "version": "0.1.0",
  "identifier": "com.ganendraditya.vision420",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "420vision",
        "width": 380,
        "height": 580,
        "resizable": false,
        "decorations": false,
        "skipTaskbar": true,
        "visible": false,
        "center": true
      }
    ],
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/32x32.png",
      "tooltip": "420vision: 20-20-20-20 Vision Assistant",
      "iconAsTemplate": true
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
